{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c0caf5"
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#9ece6a"
  },
  "paragraph": {
    "color": "#c0caf5"
  },
  "list": {
    "level_indent": 2,
    "color": "#c0caf5"
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#7aa2f7",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#7aa2f7",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#bb9af7",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#7dcfff",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#e0af68",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#c0caf5",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#565f89",
    "bold": true
  },
  "text": {
    "color": "#c0caf5"
  },
  "strong": {
    "bold": true,
    "color": "#c0caf5"
  },
  "emph": {
    "italic": true,
    "color": "#c0caf5"
  },
  "hr": {
    "color": "#565f89"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "color": "#7aa2f7"
  },
  "task": {
    "color": "#7aa2f7",
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#7aa2f7",
    "underline": true
  },
  "link_text": {
    "color": "#7dcfff"
  },
  "image": {
    "color": "#7dcfff",
    "underline": true
  },
  "image_text": {
    "color": "#7dcfff"
  },
  "code": {
    "color": "#e0af68",
    "background_color": "#1f2335"
  },
  "code_block": {
    "color": "#c0caf5",
    "background_color": "#1f2335",
    "margin": 1,
    "chroma": {
      "text": {
        "color": "#c0caf5",
        "background_color": "#1f2335"
      },
      "error": {
        "color": "#f7768e",
        "background_color": "#1f2335"
      },
      "comment": {
        "color": "#565f89"
      },
      "comment_preproc": {
        "color": "#7aa2f7"
      },
      "keyword": {
        "color": "#bb9af7"
      },
      "keyword_reserved": {
        "color": "#bb9af7"
      },
      "keyword_namespace": {
        "color": "#bb9af7"
      },
      "keyword_type": {
        "color": "#2ac3de"
      },
      "operator": {
        "color": "#89ddff"
      },
      "punctuation": {
        "color": "#89ddff"
      },
      "name": {
        "color": "#c0caf5"
      },
      "name_builtin": {
        "color": "#7aa2f7"
      },
      "name_function": {
        "color": "#7aa2f7"
      },
      "name_class": {
        "color": "#e0af68"
      },
      "name_variable": {
        "color": "#c0caf5"
      },
      "literal": {
        "color": "#ff9e64"
      },
      "literal_number": {
        "color": "#ff9e64"
      },
      "literal_string": {
        "color": "#9ece6a"
      },
      "generic_deleted": {
        "color": "#f7768e"
      },
      "generic_inserted": {
        "color": "#9ece6a"
      },
      "generic_heading": {
        "color": "#7aa2f7",
        "bold": true
      },
      "generic_subheading": {
        "color": "#7dcfff",
        "bold": true
      }
    }
  },
  "table": {
    "center_separator": "│",
    "column_separator": "│",
    "row_separator": "─",
    "color": "#c0caf5"
  },
  "definition_list": {
    "color": "#c0caf5"
  },
  "definition_term": {
    "color": "#7aa2f7",
    "bold": true
  },
  "definition_description": {
    "color": "#c0caf5"
  }
}
