# modern-terminal: delta as git's pager, Tokyo Night Storm colours.
# Added to your global git config by install.sh with `git config --global --add include.path`.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true
	syntax-theme = tokyonight_storm
	minus-style = syntax "#3f2d3d"
	minus-emph-style = syntax "#763842"
	plus-style = syntax "#283b4d"
	plus-emph-style = syntax "#316172"
	line-numbers-minus-style = "#f7768e"
	line-numbers-plus-style = "#9ece6a"
	line-numbers-zero-style = "#565f89"
	file-style = "#7aa2f7"
	file-decoration-style = "#7aa2f7 ul"
	hunk-header-style = "#7dcfff"
	hunk-header-decoration-style = "#565f89 box"
[merge]
	conflictStyle = zdiff3
