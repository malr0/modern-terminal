# modern-terminal: core tools. Install with: brew bundle --file Brewfile

# Terminal and font (the font provides the icons used by eza and starship)
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"

# Shell
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "fzf"
brew "zoxide"

# Search and view
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "glow"
brew "jq"
brew "sd"
brew "ast-grep"

# Git
brew "git-delta"
brew "lazygit"
brew "gh"

# Editors
brew "helix"
brew "micro"

# System
brew "btop"
